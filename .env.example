# Instagram Hesap Bilgileri
# Bot'un çalışacağı Instagram hesabı (Reels paylaşan hesap)
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password

# Senin kişisel Instagram kullanıcı adın
# Sadece bu hesaptan gelen DM'ler işlenir (güvenlik)
OWNER_USERNAME=your_personal_username

# DM kontrol aralığı (saniye) - kaç saniyede bir DM kutusunu kontrol etsin
DM_CHECK_INTERVAL=30

# Render.com portu
PORT=10000
